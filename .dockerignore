# =============================================================================
# Docker build context (context = repo root): keep the "transferring context"
# step small and free of anything sensitive. Everything excluded here is
# either rebuilt inside the images or not needed by any build.
#
# NEVER exclude: pnpm-lock.yaml, package.json, pnpm-workspace.yaml and the
# workspace package.json files (apps/*, packages/*) - they are COPY-ed by
# the manifest stage of both Dockerfiles.
# =============================================================================

# --- VCS: the .git folder especially is heavy ---
.git
.gitignore
.gitattributes
.github

# --- dependency trees: installed inside the images ---
node_modules
**/node_modules

# --- build outputs and caches: rebuilt inside the images ---
**/.output
**/.nuxt
**/dist
**/.cache
.turbo
.vite
coverage
apps/web/.data

# --- environment files: never bake secrets into the context ---
.env
.env.*
!.env.example

# --- Docker orchestration: no container needs these in its context ---
compose.yml
compose.prod.yml
**/Dockerfile

# --- logs, OS noise, editors ---
*.log
logs
.DS_Store
Thumbs.db
.vscode
.idea

# --- docs and metadata not needed by the builds ---
# (verified: no build script reads a .md or the LICENSE file)
docs
/*.md
LICENSE

# --- test and coverage reports ---
test-results
playwright-report
